# ---------------------------------------------------------------------------
# Copy to .env for local runs:   cp .env.example .env
# In GitHub Actions, set these as repository Secrets / Variables instead.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gmail account that sends the newsletter (requires 2-Step Verification).
GMAIL_ADDRESS=you@gmail.com
# 16-character App Password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Optional ---------------------------------------------------------------
# Comma-separated recipients (sent as Bcc). Defaults to GMAIL_ADDRESS.
RECIPIENT_EMAILS=you@gmail.com,colleague@example.com

# Gemini model id. Defaults to the latest stable Pro alias.
GEMINI_MODEL=gemini-pro-latest

# Timezone used for the report date shown in the newsletter.
REPORT_TIMEZONE=Asia/Bangkok

# Comma-separated RSS/Atom feed URLs. Leave unset to use the built-in defaults.
# RSS_FEEDS=https://feeds.content.dowjones.io/public/rss/mw_topstories,https://feeds.bloomberg.com/markets/news.rss

# LOOKBACK_HOURS=24
# MAX_ARTICLES_PER_FEED=15
# MAX_TOTAL_ARTICLES=60
# SENDER_NAME=Daily Market Brief

# Set to true to generate the HTML without sending email.
# DRY_RUN=false
